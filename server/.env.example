# MongoDB Atlas connection string (Atlas > Connect > Drivers), e.g. mongodb+srv://user:pass@cluster0.abcde.mongodb.net/
MONGODB_URI=
# Random secret of 32+ characters for admin login; make one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Website address(es), comma separated, no trailing slash, e.g. https://fashionabledecor.in,https://www.fashionabledecor.in
# (also used as the sitemap domain: put the main live domain first)
CLIENT_URL=http://localhost:5173
# Cloudinary cloud name (Cloudinary Console > Settings > API Keys)
CLOUDINARY_CLOUD_NAME=
# Cloudinary API key (same page)
CLOUDINARY_API_KEY=
# Cloudinary API secret (same page)
CLOUDINARY_API_SECRET=
# Lead emails (Gmail SMTP). Render's free plan blocks SMTP ports, so after deployment use an HTTP email
# service instead. If email fails the lead is still saved and the form is never slowed down.
# Gmail address that sends new-lead emails
SMTP_USER=
# Gmail App Password (16 letters, from myaccount.google.com/apppasswords), not the normal password
SMTP_PASS=
# Inbox that receives new-lead emails
LEAD_NOTIFY_EMAIL=
# On hosting only: set NODE_ENV=production
NODE_ENV=development
