# Backend API address: http://localhost:5000/api locally.
# On Netlify set VITE_API_URL=/api (Site settings > Environment variables); public/_redirects forwards /api to Render.
VITE_API_URL=http://localhost:5000/api
# Optional Meta Pixel ID (digits only, from Meta Events Manager); leave empty to turn tracking off
VITE_META_PIXEL_ID=
